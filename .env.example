# 이 파일을 .env 로 복사한 뒤 값을 채우세요. .env 는 git에 올라가지 않습니다.
# 실제 키 값을 이 .env.example 파일에 적지 마세요.

# 통계청 KOSIS 공유서비스 (https://kosis.kr/openapi/)
KOSIS_API_KEY=

# 열린국회정보 (https://open.assembly.go.kr)
ASSEMBLY_API_KEY=

# 국회예산정책처 Open API (선택, https://www.nabo.go.kr)
NABO_API_KEY=

# 국민참여입법센터 사용자 ID (선택, https://opinion.lawmaking.go.kr)
LAWMKING_OC=

# 법제처 국가법령정보 공동활용 OC (https://open.law.go.kr)
LAW_OC=

# KIPRIS Plus (https://plus.kipris.or.kr)
KIPRIS_API_KEY=
